{
  "company": {
    "type": "object", "additionalProperties": false,
    "required": ["company_id", "name", "industry", "capacity"],
    "properties": {
      "company_id": {"type": "string", "pattern": "^C-\\d{3}$"},
      "name": {"type": "string", "minLength": 1},
      "industry": {"type": "string", "minLength": 1},
      "capacity": {"type": "integer", "minimum": 1, "maximum": 30}
    }
  },
  "need_card": {
    "type": "object", "additionalProperties": false,
    "required": ["need_id", "company_id", "version", "confirmed", "lang", "outcomes", "skills", "languages", "constraints", "company_reality_notes"],
    "properties": {
      "need_id": {"type": "string", "pattern": "^N-\\d{3}$"},
      "company_id": {"type": "string", "pattern": "^C-\\d{3}$"},
      "version": {"type": "integer", "minimum": 1},
      "confirmed": {"type": "boolean"},
      "lang": {"enum": ["en", "fi"]},
      "outcomes": {"type": "array", "minItems": 2, "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "text", "priority", "skills"],
        "properties": {"id": {"type": "string", "pattern": "^o\\d$"}, "text": {"type": "string", "minLength": 10}, "priority": {"enum": ["must", "learnable", "nice"]},
                       "skills": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^http://data\\.europa\\.eu/esco/skill/[0-9a-f-]{36}$"}}}}},
      "skills": {"type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["esco_uri", "label", "level"],
        "properties": {"esco_uri": {"type": "string", "pattern": "^http://data\\.europa\\.eu/esco/skill/[0-9a-f-]{36}$"}, "label": {"type": "string"}, "level": {"enum": ["must", "learnable", "nice"]}}}},
      "languages": {"type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["lang", "required"],
        "properties": {"lang": {"type": "string", "pattern": "^[a-z]{2}$"}, "required": {"type": "boolean"}}}},
      "constraints": {
        "type": "object", "additionalProperties": false, "required": ["onsite", "start", "intl_ok", "relocation_support"],
        "properties": {"onsite": {"enum": ["onsite", "hybrid", "remote"]}, "start": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
                       "intl_ok": {"type": "boolean"}, "relocation_support": {"enum": ["none", "partial", "full"]}}},
      "company_reality_notes": {"type": "array", "items": {"type": "string", "minLength": 5}}
    }
  },
  "jobseeker": {
    "type": "object", "additionalProperties": false,
    "required": ["candidate_id", "story", "constraints", "experience_industry"],
    "properties": {
      "candidate_id": {"type": "string", "pattern": "^J-\\d{3}$"},
      "story": {
        "type": "object", "additionalProperties": false, "required": ["lang", "problem", "did", "differently", "next", "used_ai"],
        "properties": {"lang": {"enum": ["en", "fi", "sv", "ar"]}, "problem": {"type": "string", "minLength": 1}, "did": {"type": "string", "minLength": 1},
                       "differently": {"type": "string"}, "next": {"type": "string", "minLength": 1}, "used_ai": {"type": "boolean"}}},
      "constraints": {
        "type": "object", "additionalProperties": false, "required": ["languages", "start", "work_mode", "needs_relocation"],
        "properties": {
          "languages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["lang", "level"],
                        "properties": {"lang": {"enum": ["en", "fi", "sv"]}, "level": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2"]}}}},
          "start": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"},
          "work_mode": {"enum": ["onsite", "hybrid", "remote"]},
          "needs_relocation": {"type": "boolean"}}},
      "experience_industry": {"type": "string", "minLength": 1}
    }
  },
  "identity": {
    "type": "object", "additionalProperties": false,
    "required": ["candidate_id", "name", "nationality", "school", "birth_year", "email", "private_context"],
    "properties": {
      "candidate_id": {"type": "string", "pattern": "^J-\\d{3}$"},
      "name": {"type": "string", "minLength": 3}, "nationality": {"type": "string"}, "school": {"type": "string"},
      "birth_year": {"type": "integer", "minimum": 1955, "maximum": 2008},
      "email": {"type": "string", "pattern": "^[a-z0-9.]+@example\\.test$"},
      "private_context": {"type": ["string", "null"]}
    }
  },
  "attributes": {
    "type": "object", "additionalProperties": false,
    "required": ["candidate_id", "background", "education", "career_gap", "style", "origin_domain", "target_domain", "planted_tags"],
    "properties": {
      "candidate_id": {"type": "string", "pattern": "^J-\\d{3}$"},
      "background": {"enum": ["international_professional", "local_graduate", "career_changer", "returner", "vocational"]},
      "education": {"enum": ["university", "applied_sciences", "vocational", "self_taught"]},
      "career_gap": {"type": "boolean"},
      "style": {"enum": ["polished", "rough"]},
      "origin_domain": {"enum": ["iot", "sw", "data", "log", "care", "cs", "mfg", "fin"]},
      "target_domain": {"enum": ["iot", "sw", "data", "log", "care", "cs", "mfg", "fin"]},
      "planted_tags": {"type": "array", "items": {"enum": ["hero", "generic", "thin"]}}
    }
  }
}
